# Minimal Email Worker Dockerfile
FROM oven/bun:1-alpine

WORKDIR /app
ENV NODE_ENV=production

# Copy only needed files
COPY package.json bun.lock* tsconfig.json ./
COPY prisma ./prisma

# Install deps (skip postinstall, run prisma generate manually)
RUN bun install --frozen-lockfile --production --ignore-scripts

# Copy source code (needed for module resolution)
COPY src ./src
COPY worker ./worker

# Generate Prisma Client
RUN bunx prisma generate

CMD ["bun", "run", "worker/email-worker.ts"]
