# Production Environment Variables
# Copy this to .env and fill in your production values

# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db:5432/roxas"
DB_USER="postgres"
DB_PASSWORD="YOUR_SECURE_PASSWORD_HERE"
DB_NAME="roxas"

# App URLs
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET_HERE_USE_openssl_rand_base64_32"

# Digiflazz
DIGIFLAZZ_USERNAME="your_username"
DIGIFLAZZ_API_KEY="your_api_key"

# Midtrans
MIDTRANS_SERVER_KEY="your_server_key"
MIDTRANS_CLIENT_KEY="your_client_key"
MIDTRANS_IS_PRODUCTION="true"

# Mailgun (optional)
MAILGUN_API_KEY="your_mailgun_api_key"
MAILGUN_DOMAIN="your_mailgun_domain"
MAILGUN_FROM_EMAIL="noreply@yourdomain.com"

# Optional: Redis for caching (if you add it)
# REDIS_URL="redis://redis:6379"
