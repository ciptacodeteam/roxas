# Production Environment Variables
# Copy this to .env.production and fill in your production values

# ============================================
# General
# ============================================
NODE_ENV="production"

# ============================================
# Database (Docker PostgreSQL)
# ============================================
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@db:5432/roxas"
DB_USER="postgres"
DB_PASSWORD="YOUR_STRONG_PASSWORD_HERE"  # Generate with: openssl rand -base64 24
DB_NAME="roxas"

# ============================================
# App URLs
# ============================================
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# ============================================
# Authentication (Better Auth)
# ============================================
AUTH_SECRET=""  # Generate with: openssl rand -base64 32
AUTH_URL="https://yourdomain.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# Digiflazz (Product Provider)
# ============================================
DIGIFLAZZ_USERNAME="your_digiflazz_username"
DIGIFLAZZ_API_KEY="your_digiflazz_api_key"
DIGIFLAZZ_API_URL="https://api.digiflazz.com/v1"

# ============================================
# Payment Gateway (Midtrans)
# ============================================
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION="true"

# ============================================
# Redis (Email Queue & Caching)
# ============================================
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD=""  # Generate with: openssl rand -base64 24

# ============================================
# Email Worker Configuration
# ============================================
EMAIL_WORKER_CONCURRENCY=5

# ============================================
# Email (Mailgun)
# ============================================
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.yourdomain.com"
MAILGUN_FROM_EMAIL="Your Store <noreply@yourdomain.com>"
MAILGUN_REGION="eu"

# ============================================
# Storage (Local File System)
# ============================================
# Files are stored in /var/www/uploads (Docker volume)
# Ensure proper permissions: chmod 755 /var/www/uploads
