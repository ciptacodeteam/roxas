# General
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Next Auth
AUTH_SECRET="your-generated-secret-here"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Digiflazz (Buyer API)
DIGIFLAZZ_USERNAME="your_digiflazz_username"
DIGIFLAZZ_API_KEY="your_digiflazz_api_key"
DIGIFLAZZ_API_URL="https://api.digiflazz.com/v1"

# Xendit (Payments)
MIDTRANS_SERVER_KEY="xnd_development_xxx"
MIDTRANS_CLIENT_KEY="your_xendit_webhook_token"

# Mailgun (Email)
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.yourdomain.com"
MAILGUN_FROM_EMAIL="Your Store <noreply@yourdomain.com>"
MAILGUN_REGION="eu"   # or "us", depending on your account

# Storage
BLOB_READ_WRITE_TOKEN="your-blob-token-here"