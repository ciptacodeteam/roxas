// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  DENY
  REFUND
}

enum DigiflazzStatus {
  PENDING
  SUKSES
  GAGAL
}

enum DigiflazzItemStatus {
  ACTIVE
  INACTIVE
}

enum PriceSyncStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum PriceSyncType {
  PREPAID
  PASCA
  FULL
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum PaymentMethodType {
  QRIS
  E_WALLET
  MOBILE_BANKING
  CREDIT_CARD
}

enum BankTransferBank {
  BCA
  BNI
  PERMATA
  MANDIRI
  BRI
  BSI
  DANAMON
  CIMB
}

// ============================================
// PAYMENT METHOD CONFIGURATION
// ============================================

model PaymentMethod {
  id          String            @id @default(uuid())
  type        PaymentMethodType // credit_card, bank_transfer, etc.
  bank        BankTransferBank? // Bank for bank_transfer (null for other methods)
  name        String            // Display name (e.g., "BCA Virtual Account", "GoPay")
  description String?           // Description for users
  icon        String?           // Icon/image URL for the payment method
  
  // Fee configuration (Midtrans charges percentage or fixed fee)
  feeType     FeeType           @default(PERCENTAGE) // PERCENTAGE or FIXED
  feeValue    Float             @default(0) // Fee percentage (e.g., 2.5 for 2.5%) or fixed amount in IDR
  
  // VAT configuration (manually configured per payment method)
  vatType     FeeType           @default(PERCENTAGE) // PERCENTAGE or FIXED (reusing FeeType enum)
  vatValue    Float             @default(0) // VAT percentage (e.g., 11 for 11%) or fixed amount in IDR
  
  // Configuration
  isActive    Boolean           @default(true)
  
  // Midtrans-specific configuration
  midtransCode String           // Code used in Midtrans API (e.g., "bca", "gopay", "credit_card")
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  orders      Order[]
  payments    Payment[]

  @@unique([type, bank]) // Ensure one payment method per type+bank combination
  @@unique([midtransCode]) // Ensure no duplicate Midtrans codes
  @@index([isActive])
  @@index([type])
  @@map("payment_methods")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  phone         String? // Custom field
  role          UserRole @default(USER) // Custom field
  isActive      Boolean  @default(true) // Soft disable accounts
  lastLoginAt   DateTime? // Track last login time
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  couponUsages CouponUsage[]
  productRatings ProductRating[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive, createdAt])
  @@index([role, isActive])
  @@map("users")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([accountId, providerId, userId])
  @@index([userId])
  @@index([providerId])
  @@map("accounts")
}

model Session {
  id              String   @id @default(uuid())
  expiresAt       DateTime
  token           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  userId          String
  lastActivityAt  DateTime @default(now()) // Track active sessions
  revokedAt       DateTime? // Manual session revocation
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, revokedAt]) // For valid sessions only
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================
// PRODUCT MODELS
// ============================================

model Category {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
  instructionImages CategoryInstructionImage[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model CategoryInstructionImage {
  id         String   @id @default(uuid())
  categoryId String
  imageUrl   String   // Image URL showing how to top-up for this category
  altText    String?  // Optional alt text for accessibility
  sortOrder  Int      @default(0) // Order for displaying multiple images
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@map("category_instruction_images")
}

model Product {
  id           String   @id @default(uuid())
  categoryId   String
  name         String
  slug         String   @unique
  /// Names of input fields required for this product, e.g. ["userId", "serverId"]
  inputFields  String[]
  description  String?
  image        String?
  bannerImage  String?
  instructions String? // How to find game ID
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    ProductItem[]
  ratings  ProductRating[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("products")
}

model ProductItem {
  id        String   @id @default(uuid())
  productId String
  name      String // "86 Diamonds"
  skuCode   String   @unique // Digiflazz buyer_sku_code
  iconImage String?  // Icon/image for this specific product item
  group     String?  // Group name for organizing items (e.g., "Diamond", "Weekly Pass")
  
  // Pricing
  basePrice      Int // Cost from Digiflazz (in IDR)
  normalPrice    Int // Regular/normal selling price (in IDR)
  discountedPrice Int? // Discounted/sale price (optional, in IDR)
  sellPrice      Int // Current effective selling price (can be manually set or calculated from normalPrice/discountedPrice)
  
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Price sync tracking
  lastSyncedAt    DateTime? // When this item's price was last synced from Digiflazz
  digiflazzStatus DigiflazzItemStatus? // "active" | "inactive" - from buyer_product_status && seller_product_status

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders         Order[]
  flashSaleItems FlashSaleItem[]

  @@index([productId])
  @@index([skuCode])
  @@index([productId, isActive, skuCode])
  @@map("product_items")
}

// Global price sync tracking
model PriceSync {
  id           String          @id @default(uuid())
  syncType     PriceSyncType   // "prepaid" | "pasca" | "full"
  status       PriceSyncStatus // "success" | "failed" | "in_progress"
  itemsSynced  Int             @default(0)
  itemsUpdated Int             @default(0)
  itemsCreated Int             @default(0)
  errorMessage String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([startedAt])
  @@index([status, startedAt])
  @@map("price_syncs")
}

// ============================================
// COUPON MODELS
// ============================================

enum DiscountType {
  PERCENTAGE // Discount as percentage (e.g., 10 = 10% off)
  FIXED_AMOUNT // Discount as fixed amount in IDR
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique // Coupon code (e.g., "WELCOME10")
  description   String? // Description of the coupon
  discountType  DiscountType // PERCENTAGE or FIXED_AMOUNT
  discountValue Int // Discount amount (percentage or fixed in IDR)
  minPurchase   Int? @default(0) // Minimum purchase amount to use coupon
  maxDiscount   Int? // Maximum discount amount (for percentage coupons)
  usageLimit    Int? // Total usage limit (null = unlimited)
  usageCount    Int  @default(0) // Current usage count
  userLimit     Int? @default(1) // Limit per user (null = unlimited per user)
  isActive      Boolean      @default(true)
  startDate     DateTime? // Optional start date
  endDate       DateTime? // Optional expiration date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usages CouponUsage[]

  @@index([isActive])
  @@index([endDate])
  @@index([isActive, endDate, createdAt])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  orderId   String   @unique
  userId    String
  discountAmount Int // Actual discount applied in IDR
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

// ============================================
// FLASH SALE MODELS
// ============================================

model FlashSale {
  id        String   @id @default(uuid())
  name      String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FlashSaleItem[]

  @@index([isActive])
  @@index([startTime])
  @@index([endTime])
  @@index([isActive, endTime, startTime])
  @@map("flash_sales")
}

model FlashSaleItem {
  id            String @id @default(uuid())
  flashSaleId   String
  productItemId String
  salePrice     Int // Discounted price
  stock         Int // Limited stock for flash sale
  soldCount     Int    @default(0)

  flashSale   FlashSale   @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productItem ProductItem @relation(fields: [productItemId], references: [id], onDelete: Restrict)

  @@unique([flashSaleId, productItemId])
  @@index([flashSaleId])
  @@index([productItemId])
  @@map("flash_sale_items")
}

// ============================================
// MARKETING BANNER MODELS
// ============================================

model MarketingBanner {
  id          String   @id @default(uuid())
  title       String?  // Optional title for the banner
  image       String   // Banner image URL
  link        String?  // Optional link/URL when banner is clicked
  description String?  // Optional description or alt text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  startDate   DateTime? // Optional start date for scheduled banners
  endDate     DateTime? // Optional end date for scheduled banners
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive, sortOrder, createdAt])
  @@index([startDate, endDate, isActive])
  @@map("marketing_banners")
}

// ============================================
// ORDER & TRANSACTION MODELS
// ============================================

enum OrderStatus {
  PENDING // Order created, awaiting payment
  PAID // Payment received, processing topup
  PROCESSING // Sent to Digiflazz
  COMPLETED // Topup successful
  FAILED // Topup failed
  REFUNDED // Payment refunded
  EXPIRED // Payment expired
}

model Order {
  id            String @id @default(uuid())
  orderNumber   String @unique // e.g. "ORD-20231217-XXXX"
  userId        String
  productItemId String

  // Customer input (game ID, server ID, phone, etc.)
  customerData Json // { "userId": "123456", "serverId": "1234" }

  // Pricing
  originalPrice Int // Original sell price
  finalPrice    Int // After discount (flash sale/coupon)
  
  // Payment fee and VAT (calculated based on selected payment method)
  paymentFee    Int @default(0) // Processing fee charged by payment provider (Midtrans)
  vatAmount     Int @default(0) // VAT amount calculated from payment fee
  totalAmount   Int // finalPrice + paymentFee + vatAmount

  // Payment method selection (for Core API)
  paymentMethodId String? // Selected payment method

  // Status
  status OrderStatus @default(PENDING)
  
  // Payment and refund tracking
  paymentExpiresAt DateTime? // When payment window closes
  refundAmount     Int? @default(0)
  refundReason     String?
  refundedAt       DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  completedAt DateTime?

  // Relations
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  productItem ProductItem           @relation(fields: [productItemId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  payment     Payment?
  digiflazzTx DigiflazzTransaction?
  couponUsage CouponUsage?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt, userId])
  @@index([paymentMethodId])
  @@index([paymentExpiresAt])
  @@map("orders")
}

model Payment {
  id      String @id @default(uuid())
  orderId String @unique

  // Midtrans data
  externalId     String  @unique // Your reference ID (order number)
  transactionId  String? @unique // Midtrans transaction ID
  
  // Payment method reference
  paymentMethodId String? // Reference to PaymentMethod
  
  // Payment URLs and instructions (Core API response - varies by payment method)
  paymentUrl         String? // Payment URL or redirect URL (generic)
  vaNumber           String? // Virtual Account number (for bank_transfer)
  qrisString         String? // QRIS payment string (for qris)
  deeplinkUrl        String? // Deep link for e-wallets (gopay, shopeepay)
  redirectUrl        String? // Redirect URL for credit card
  
  // Expiry information
  amount    Int // Amount charged (includes payment fee)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  expiresAt DateTime?

  // Raw webhook data
  webhookData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([externalId])
  @@index([transactionId])
  @@index([status])
  @@index([orderId])
  @@index([paymentMethodId])
  @@index([createdAt, status])
  @@map("payments")
}

model DigiflazzTransaction {
  id      String @id @default(uuid())
  orderId String @unique

  // Digiflazz data
  refId      String  @unique // Your reference ID
  trxId      String? // Digiflazz transaction ID
  skuCode    String
  customerNo String // Game ID / phone number

  status       DigiflazzStatus @default(PENDING)
  message      String?
  serialNumber String? // SN for vouchers

  // Raw response data
  responseData Json?
  webhookData  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([refId])
  @@index([status])
  @@index([orderId])
  @@index([trxId])
  @@index([createdAt, status])
  @@map("digiflazz_transactions")
}

// ============================================
// RATING MODELS
// ============================================

model ProductRating {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  rating    Int      // 1-5 stars
  comment   String?  // Optional review comment
  userName  String?  // Display name for the reviewer
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, isActive])
  @@index([isActive])
  @@index([userId])
  @@map("product_ratings")
}

// ============================================
// AUDIT LOG MODEL
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  entityType String // "Order", "Product", "User", etc.
  entityId  String
  action    String // "CREATE", "UPDATE", "DELETE"
  changes   Json? // Track what changed
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
