# Optimized Development Dockerfile
FROM oven/bun:1.3-alpine

WORKDIR /app

# Install system deps (single layer)
RUN apk add --no-cache postgresql-client wget curl

# Copy package files first (dependency caching)
COPY package.json bun.lock* ./
COPY prisma ./prisma

# Install dependencies
RUN bun install --frozen-lockfile

# Copy config files
COPY tsconfig.json next.config.js postcss.config.js prettier.config.js ./
COPY components.json eslint.config.js ./

# Copy source (changes most often - last)
COPY src ./src
COPY public ./public

# Setup
RUN mkdir -p .next && touch next-env.d.ts

EXPOSE 3000 5555

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["bun", "run", "dev"]
