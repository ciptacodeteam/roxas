# General
NODE_ENV=development

# Django Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roxas?schema=public"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="roxas"

# Next Auth
AUTH_SECRET="your-generated-secret-here"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Digiflazz (Buyer API)
DIGIFLAZZ_USERNAME="your_digiflazz_username"
DIGIFLAZZ_API_KEY="your_digiflazz_api_key"
DIGIFLAZZ_API_URL="https://api.digiflazz.com/v1"

# Midtrans (Payments)
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION="false"

NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
NGROK_DOMAIN=
NGROK_FREE_PLAN=true

# Redis (Email Queue)
REDIS_URL="redis://localhost:6379"

# Email Worker Configuration (Optional)
EMAIL_WORKER_CONCURRENCY=5

# Mailgun (Email)
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.yourdomain.com"
MAILGUN_FROM_EMAIL="Your Store <noreply@yourdomain.com>"
MAILGUN_REGION="eu"   # or "us", depending on your account

# Storage
# BLOB_READ_WRITE_TOKEN="your-blob-token-here" # No longer needed - using local file storage