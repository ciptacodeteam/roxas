# ============================================
# PRODUCTION ENVIRONMENT VARIABLES - Roxas Game Store
# ============================================
# Copy this file to .env and update with your actual values
# SECURITY: Never commit .env file to version control!

# ============================================
# Django Settings
# ============================================
DJANGO_SETTINGS_MODULE=backend.settings
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-me-to-secure-random-key-in-production
DEBUG=0
# Add your domain(s) separated by commas
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Add your frontend URL(s) for CSRF protection
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL=postgres://roxas_user:your-secure-database-password@db:5432/roxas_gamestore

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=roxas_gamestore
SQL_USER=roxas_user
SQL_PASSWORD=your-secure-database-password
SQL_HOST=db
SQL_PORT=5432
DB_CONN_MAX_AGE=300

# ============================================
# CORS Configuration
# ============================================
# Add your frontend domain(s)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ============================================
# JWT Token Configuration
# ============================================
# Access token lifetime in minutes (default: 15 minutes)
ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token lifetime in days (default: 7 days)
REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================
# Email Configuration (Mailgun)
# ============================================
# Option 1: Use Mailgun HTTP API (RECOMMENDED)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=yourdomain.com
# Optional: Use EU region for GDPR compliance
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3

# Option 2: Use SMTP (fallback - may be blocked)
# MAILGUN_SMTP_SERVER=smtp.mailgun.org
# MAILGUN_SMTP_PORT=587
# MAILGUN_SMTP_LOGIN=postmaster@yourdomain.com
# MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password

DEFAULT_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================
# Celery Configuration (Task Queue)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_URL=redis://redis:6379/1

# ============================================
# Payment Gateway - Midtrans
# ============================================
# Get from: https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=your-midtrans-production-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-production-client-key
# Use true for production, false for sandbox/testing
MIDTRANS_IS_PRODUCTION=true

# ============================================
# Game Top-Up Provider - Digiflazz
# ============================================
# Get from: https://member.digiflazz.com/
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=your-digiflazz-production-key
# Use true for production, false for sandbox/testing
DIGIFLAZZ_IS_PRODUCTION=true

# ============================================
# Security Settings (Production)
# ============================================
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true