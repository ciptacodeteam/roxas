# Django Settings
DJANGO_SETTINGS_MODULE=backend.settings
SECRET_KEY=change-me-to-secure-random-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=localhost,127.0.0.1

# ============================================
# ENVIRONMENT MODE
# Controls sandbox/testing mode for Midtrans and Digiflazz.
# development → Midtrans sandbox, Digiflazz testing=true (no real money)
# production  → Midtrans live, Digiflazz real transactions
# ============================================
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgres://roxas_user:your-secure-password@db:5432/roxas_gamestore

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=roxas_gamestore
SQL_USER=roxas_user
SQL_PASSWORD=your-secure-password
SQL_HOST=db
SQL_PORT=5432
DB_CONN_MAX_AGE=300

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie Domain (optional - set for cross-domain cookie sharing)
# For production: COOKIE_DOMAIN=.yourdomain.com (note the leading dot)
# For localhost: Leave empty or unset
COOKIE_DOMAIN=

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Must use a verified domain in Resend (https://resend.com/domains)
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=http://localhost:3000

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/1

# Security Settings (Production)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Midtrans Payment Gateway (Sandbox for Development)
# Get sandbox credentials from: https://dashboard.sandbox.midtrans.com/
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
# Optional override (leave unset to auto-derive from ENVIRONMENT above)
# MIDTRANS_IS_PRODUCTION=false

# Digiflazz Game Top-Up (Development/Testing)
# Get sandbox credentials from: https://member.digiflazz.com/
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=your-digiflazz-development-key
DIGIFLAZZ_API_URL=https://api.digiflazz.com/v1
# Optional override (leave unset to auto-derive from ENVIRONMENT above)
# DIGIFLAZZ_IS_PRODUCTION=false
# Webhook secret for validating incoming webhooks from Digiflazz (optional but recommended)
DIGIFLAZZ_WEBHOOK_SECRET=your-webhook-secret
# Minimum balance (IDR) before a low-balance alert email is fired
DIGIFLAZZ_LOW_BALANCE_THRESHOLD=100000
# Admin email for operational alerts (low balance, system errors); leave empty to disable
ADMIN_ALERT_EMAIL=
# Webhook IP allowlists (comma-separated CIDRs/IPs); leave empty for no restriction in dev
# In production, Midtrans defaults automatically to 103.208.23.0/24,103.179.188.0/28 when empty
# MIDTRANS_WEBHOOK_ALLOWED_IPS=103.208.23.0/24,103.179.188.0/28
# DIGIFLAZZ_WEBHOOK_ALLOWED_IPS=