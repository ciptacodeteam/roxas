# Django Settings
DJANGO_SETTINGS_MODULE=backend.settings
SECRET_KEY=change-me-to-secure-random-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgres://roxas_user:your-secure-password@db:5432/roxas_gamestore

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=roxas_gamestore
SQL_USER=roxas_user
SQL_PASSWORD=your-secure-password
SQL_HOST=db
SQL_PORT=5432
DB_CONN_MAX_AGE=300

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Cookie Domain (optional - set for cross-domain cookie sharing)
# For production: COOKIE_DOMAIN=.yourdomain.com (note the leading dot)
# For localhost: Leave empty or unset
COOKIE_DOMAIN=

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Configuration (Mailgun)
# Option 1: Use Mailgun HTTP API (RECOMMENDED - bypasses SMTP port blocks)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=yourdomain.com
# Optional: Use EU region (default is US)
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3

# Option 2: Use SMTP (may be blocked by firewall - use API instead)
# MAILGUN_SMTP_SERVER=smtp.mailgun.org
# MAILGUN_SMTP_PORT=587
# MAILGUN_SMTP_LOGIN=your-mailgun-smtp-login
# MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password

DEFAULT_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=http://localhost:3000

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/1

# Security Settings (Production)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Midtrans Payment Gateway (Sandbox for Development)
# Get sandbox credentials from: https://dashboard.sandbox.midtrans.com/
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false

# Digiflazz Game Top-Up (Development/Testing)
# Get sandbox credentials from: https://member.digiflazz.com/
DIGIFLAZZ_USERNAME=your-digiflazz-username
DIGIFLAZZ_API_KEY=your-digiflazz-development-key
DIGIFLAZZ_IS_PRODUCTION=false
# Webhook secret for validating incoming webhooks from Digiflazz (optional but recommended)
DIGIFLAZZ_WEBHOOK_SECRET=your-webhook-secret