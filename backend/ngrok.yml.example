# Ngrok Configuration Template
# Copy this file to ngrok.yml and add your authtoken
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken

authtoken: YOUR_NGROK_AUTHTOKEN_HERE

version: "2"

tunnels:
  # Django backend tunnel
  backend:
    proto: http
    addr: 8000
    
    # Optional: Custom subdomain (requires paid plan)
    # subdomain: roxas-backend-dev
    
    # Optional: Custom domain (requires paid plan)
    # hostname: dev.roxasgamestore.com
    
    # Request inspection
    inspect: true
    
    # Optional: Basic auth for security
    # auth: "username:password"
    
    # Custom headers
    host_header: "localhost:8000"

# Log configuration
log_level: info
log_format: json
log: ./ngrok.log

# Web interface for monitoring requests
web_addr: localhost:4040

# Region (use closest to your location)
# Options: us, eu, ap, au, sa, jp, in
region: ap  # Asia Pacific
