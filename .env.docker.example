# ============================================
# Docker-specific Environment Variables
# ============================================
# Copy this to .env and fill in your actual values

# ============================================
# General
# ============================================
NODE_ENV=development

# ============================================
# Database (Neon PostgreSQL)
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ============================================
# Authentication (Better Auth)
# ============================================
AUTH_SECRET="your-generated-secret-here"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# Digiflazz (Product Provider)
# ============================================
DIGIFLAZZ_USERNAME="your_digiflazz_username"
DIGIFLAZZ_API_KEY="your_digiflazz_api_key"
DIGIFLAZZ_API_URL="https://api.digiflazz.com/v1"

# ============================================
# Payment Gateway (Midtrans/Xendit)
# ============================================
MIDTRANS_SERVER_KEY="xnd_development_xxx"
MIDTRANS_CLIENT_KEY="your_client_key"

# ============================================
# Ngrok (Required for Docker setup)
# ============================================
# Get your auth token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: Custom domain (for paid ngrok plans)
# NGROK_DOMAIN=your-custom-domain.ngrok.io

# ============================================
# Email (Mailgun)
# ============================================
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.yourdomain.com"
MAILGUN_FROM_EMAIL="Roxas <noreply@yourdomain.com>"
MAILGUN_REGION="eu"   # or "us"

# ============================================
# Storage (Vercel Blob)
# ============================================
BLOB_READ_WRITE_TOKEN="your-blob-token-here"

# ============================================
# Webhook Base URL (Auto-configured by ngrok)
# ============================================
# This will be automatically set when ngrok starts
# You can also manually set it if needed
# WEBHOOK_BASE_URL="https://your-ngrok-url.ngrok.io/webhooks"
